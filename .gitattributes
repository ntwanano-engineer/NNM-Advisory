# Normalize line endings. Text files use LF in the repo.
* text=auto eol=lf

# Files that MUST stay LF (executed on Linux CI runners / in containers).
*.sh    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
Dockerfile text eol=lf

# Binary assets - never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.svg   text eol=lf
*.ico   binary