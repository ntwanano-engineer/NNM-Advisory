# NNM Advisory API — environment variable sample file
#
# Copy this file to api/.env and fill in real values before running locally.
# NEVER commit api/.env to version control — it is listed in .gitignore.
# All variables listed here are required; the application will halt at startup
# and print the name of each missing variable if any are absent (Req 12.6).

# ── Database ────────────────────────────────────────────────────────────────
# Full Npgsql connection string to the PostgreSQL database.
# When using Docker Compose, "db" resolves to the postgres service container.
DB_CONNECTION_STRING=Host=db;Port=5432;Database=nnmdb;Username=nnm;Password=devpassword

# ── JWT Authentication ───────────────────────────────────────────────────────
# HS256 signing secret — must be at least 32 characters (256 bits).
# Generate a secure value with: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars

# ── Email ────────────────────────────────────────────────────────────────────
# Set EMAIL_PROVIDER to "smtp" for local dev (Mailhog) or "ses" for AWS.
EMAIL_PROVIDER=smtp

# SMTP settings — used when EMAIL_PROVIDER=smtp.
# Default Mailhog settings; change if using a different local SMTP server.
SMTP_HOST=mailhog
SMTP_PORT=1025

# Verified sender address shown in the From header of outbound emails.
SENDER_EMAIL=noreply@nnmadvisory.local

# Company inbox that receives Admin Notification Emails on contact submissions.
ADMIN_EMAIL=admin@nnmadvisory.local

# ── Image Storage ────────────────────────────────────────────────────────────
# Set IMAGE_STORAGE_PROVIDER to "local" for local dev or "s3" for AWS.
IMAGE_STORAGE_PROVIDER=local

# S3 bucket name for leadership profile photographs.
# Ignored when IMAGE_STORAGE_PROVIDER=local.
S3_IMAGES_BUCKET=nnm-local-images

# ── CORS ─────────────────────────────────────────────────────────────────────
# The single frontend origin the API will accept cross-origin requests from.
# Must match the exact scheme + host + port the React dev server is running on.
CORS_ALLOWED_ORIGIN=http://localhost:3000
