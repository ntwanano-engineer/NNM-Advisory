{
  "AllowedHosts": "*",

  // Serilog replaces the built-in logging pipeline.
  // WriteTo.Console emits structured JSON to stdout, which is picked up by
  // the Docker log driver and forwarded to CloudWatch Logs (/nnm/api).
  // WriteTo.File acts as the local fallback required by Requirement 10.8 if
  // the primary log store (CloudWatch) is unavailable.
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nnm-api-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  // Non-sensitive defaults. Real values are injected via environment variables
  // (local) or AWS Systems Manager Parameter Store (production).
  "Jwt": {
    "Issuer": "NnmAdvisory",
    "Audience": "NnmAdvisoryAdmin",
    "ExpiryMinutes": 60
  }
}
