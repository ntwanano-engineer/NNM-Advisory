# Copy to terraform.tfvars and adjust per environment/account.
# Do NOT commit a real terraform.tfvars containing environment-specific values.

aws_region   = "af-south-1"
project_name = "nnm-advisory"
environment  = "prod"

# Networking (defaults match the design; override only if needed).
# vpc_cidr             = "10.0.0.0/16"
# public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
# private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
# az_count             = 2

additional_tags = {
  Owner = "nnm-advisory"
}

# --- RDS PostgreSQL (task 24.3) ---------------------------------------------
# db_password is SENSITIVE and has no default. Do NOT put it in this file or in
# a committed terraform.tfvars. Supply it via the TF_VAR_db_password environment
# variable or a secrets backend. The connection string is also stored in SSM
# Parameter Store as a SecureString (task 24.9).
#
# db_name                   = "nnmadvisory"
# db_username               = "nnmadmin"
# db_engine_version         = "14"
# db_instance_class         = "db.t3.medium"
# db_allocated_storage      = 20
# db_max_allocated_storage  = 100   # > allocated_storage enables storage auto-scaling
# db_multi_az               = false # set true for production
# db_backup_retention_period = 7
# db_deletion_protection    = true
# db_skip_final_snapshot    = false

# --- SSM secrets + ECS IAM (task 24.9) --------------------------------------
# jwt_secret is SENSITIVE and has no default. Do NOT put it in this file or in
# a committed terraform.tfvars. Supply it via the TF_VAR_jwt_secret environment
# variable or a secrets backend. It is stored in SSM Parameter Store as a
# SecureString (/nnm/jwt/secret) for the API to read at runtime.
#
# The remaining values default off var.domain_name; override only if needed:
# ses_sender_email    = "noreply@nnmadvisory.com"   # defaults to noreply@<domain_name>
# ses_admin_email     = "admin@nnmadvisory.com"     # defaults to admin@<domain_name>
# cors_allowed_origin = "https://nnmadvisory.com"   # defaults to https://<domain_name>

# --- CloudWatch monitoring + ECS auto-scaling (task 24.11) ------------------
# alarm_email subscribes an address to the alarm SNS topic. Leave unset (or "")
# to create the topic with no subscription. If set, AWS sends a confirmation
# email that must be accepted before notifications are delivered.
#
# alarm_email      = "ops@nnmadvisory.com"
# ecs_min_capacity = 1    # floor for target-tracking auto-scaling
# ecs_max_capacity = 4    # ceiling for target-tracking auto-scaling
# ecs_cpu_target   = 80   # scale when sustained average CPU crosses this %
