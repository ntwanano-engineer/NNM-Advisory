# ---------------------------------------------------------------------------
# NNM Advisory - CloudFormation deploy variables (example)
# Copy to deploy.env and fill in real values. Do NOT commit deploy.env.
# ---------------------------------------------------------------------------

# Region to deploy into.
export AWS_REGION=af-south-1

# App/stack name prefix.
export APP=nnm

# --- Data stack secrets -----------------------------------------------------
# Strong RDS master password (12+ chars).
export DB_PASSWORD=CHANGE_ME_strong_password

# JWT signing secret (32+ chars). Generate: openssl rand -base64 32
export JWT_SECRET=CHANGE_ME_base64_32_bytes

# --- Email -----------------------------------------------------------------
export SENDER_EMAIL=noreply@nnmadvisory.com
export ADMIN_EMAIL=admin@nnmadvisory.com

# --- Frontend origin the API accepts CORS from -----------------------------
# Use the CloudFront URL for a first deploy, then your custom domain later.
export CORS_ALLOWED_ORIGIN=https://www.nnmadvisory.com

# --- API container image (set after the ECR build/push step) ---------------
# <acct>.dkr.ecr.<region>.amazonaws.com/nnm-api:latest
export API_IMAGE_URI=

# --- Optional TLS / domains ------------------------------------------------
# Regional ACM cert ARN for the ALB (HTTPS). Empty = API served over HTTP only.
export API_CERTIFICATE_ARN=
# us-east-1 ACM cert ARN for CloudFront + the alias domain. Both empty = default cert only.
export WEB_CERTIFICATE_ARN=
export WEB_DOMAIN_NAME=